---
/**
 * Dot grid background with a soft orange light beam (no JavaScript).
 *
 * Adapted from Magic UI "Dot Pattern" (MIT): https://magicui.design/docs/components/dot-pattern
 * Changes: drawn with CSS gradients on ONE element instead of an SVG with
 * one <circle> per dot. We first tried an SVG pattern + CSS mask + a blurred
 * beam; on phones without fast graphics (and in PageSpeed's test browser)
 * painting those cost seconds of main-thread time. Gradients are cheap.
 * Styles: .dot-pattern in src/styles/global.css. It fades in once (400 ms).
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<div aria-hidden="true" class:list={["dot-pattern pointer-events-none absolute inset-0 animate-beam", className]}></div>
