---
/** /machines/: every machine model with parts, grouped by brand. */
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { machinesByBrand, site } from "../lib/data";
---
<Base
  title={`Find parts by machine | ${site.name}`}
  description="Spare parts by machine brand and model: Juki, Brother, Jack, Siruba, Pegasus and more."
>
  <div class="wrap">
    <Breadcrumbs crumbs={[["Home", "/"]]} current="Machines" />
    <header class="pb-2">
      <h1>Find parts by machine</h1>
      <p class="lead">Choose your machine model to see every part we stock for it.</p>
    </header>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-4 pb-10">
      {Object.entries(machinesByBrand).map(([brand, list]) => (
        <section class="spot p-4" data-reveal>
          <h2 class="mb-2.5 font-head text-2xl leading-none font-extrabold uppercase">{brand}</h2>
          <ul class="m-0 list-none p-0">
            {list.map((m) => (
              <li>
                <a href={m.url} class="flex min-h-11 items-center justify-between border-b border-line py-2.5 font-semibold no-underline">
                  {m.model} <small class="font-normal text-ink-2">{m.skus.length} parts</small>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
