---
/** /search/?q=...: results are found in the browser (SearchResults island). */
import Base from "../layouts/Base.astro";
import SearchResults from "../components/islands/SearchResults";
import { site } from "../lib/data";
---
<Base title={`Search parts | ${site.name}`} noindex>
  <!-- min-h reserves room for results, so the footer doesn't jump down
       when they appear (that jump counts as layout shift, CLS). -->
  <div class="wrap section min-h-[100svh]">
    <SearchResults client:load whatsapp={site.whatsappNumber} />
  </div>
</Base>
