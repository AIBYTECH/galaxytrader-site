---
/**
 * Shared layout for every page: <head> (SEO tags), header (logo, search,
 * reorder list, WhatsApp), category menu, footer and the toast island.
 *
 * Islands in the header hydrate with client:idle, i.e. after the page has
 * finished loading, so they never delay the first paint.
 */
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import SearchBox from "../components/islands/SearchBox";
import ListBadge from "../components/islands/ListBadge";
import Toaster from "../components/islands/Toaster";
import { site, topCategories, waLink } from "../lib/data";

interface Props {
  title: string;
  description?: string;
  /** Absolute URL of a share image (product photo) for WhatsApp/Facebook previews. */
  ogImage?: string;
  /** Image to preload (only the product photo, which is the LCP element). */
  preloadImage?: string;
  noindex?: boolean;
}
const { title, description = site.longTagline, ogImage, preloadImage, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.baseUrl).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" content="#1A1A1A" />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/barlow-condensed-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only z-50 bg-ink px-3 py-2 text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2">
      Skip to content
    </a>

    <header class="relative z-20 border-b border-line bg-white">
      <!-- Phone: row 1 = logo + list, row 2 = search. Desktop: one row. -->
      <div class="wrap flex flex-wrap items-center gap-x-5 gap-y-2.5 py-3">
        <Logo />
        <div class="order-3 flex w-full lg:order-none lg:w-auto lg:flex-1">
          <SearchBox client:idle />
        </div>
        <nav class="ml-auto flex gap-2 lg:ml-0" aria-label="Quick actions">
          <a href="/list/" class="btn btn-outline px-2.5 sm:px-3" aria-label="Reorder list">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M9 6h11M9 12h11M9 18h11" /><circle cx="4.5" cy="6" r="1.2" /><circle cx="4.5" cy="12" r="1.2" /><circle cx="4.5" cy="18" r="1.2" />
            </svg>
            <span class="hidden sm:inline">Reorder list</span>
            <ListBadge client:idle />
          </a>
          <a href={waLink()} rel="noopener" class="btn btn-accent hidden sm:inline-flex" data-wa-click="header">WhatsApp</a>
        </nav>
      </div>
      <nav class="border-t border-line" aria-label="Categories">
        <div class="wrap flex gap-5.5 overflow-x-auto whitespace-nowrap [scrollbar-width:none]">
          {topCategories.map((c) => (
            <a href={c.url} class="py-3 text-sm font-medium no-underline">{c.name}</a>
          ))}
          <a href="/machines/" class="py-3 text-sm font-bold text-accent-text no-underline">Shop by machine</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-5 bg-ink text-sm text-[#d5d8dd]">
      <div class="wrap grid grid-cols-[repeat(auto-fit,minmax(210px,1fr))] gap-7 pt-11 pb-6">
        <div>
          <Logo light />
          <p class="mt-3 mb-0">{site.longTagline}</p>
        </div>
        <div>
          <h2 class="mb-2.5 text-[15px] text-white">Categories</h2>
          {topCategories.map((c) => <a href={c.url} class="block py-1 text-[#d5d8dd] no-underline hover:text-white">{c.name}</a>)}
        </div>
        <div>
          <h2 class="mb-2.5 text-[15px] text-white">Help</h2>
          <a href="/list/" class="block py-1 text-[#d5d8dd] no-underline hover:text-white">Your reorder list</a>
          <a href="/machines/" class="block py-1 text-[#d5d8dd] no-underline hover:text-white">Find parts by machine</a>
          <a href="/about/" class="block py-1 text-[#d5d8dd] no-underline hover:text-white">About us</a>
          <a href="/contact/" class="block py-1 text-[#d5d8dd] no-underline hover:text-white">Contact</a>
          <a href="/privacy/" class="block py-1 text-[#d5d8dd] no-underline hover:text-white">Privacy</a>
        </div>
        <div>
          <h2 class="mb-2.5 text-[15px] text-white">Contact</h2>
          <a href={waLink()} rel="noopener" data-wa-click="footer" class="block py-1 text-[#d5d8dd] no-underline hover:text-white">WhatsApp {site.whatsappDisplay}</a>
          <a href={`mailto:${site.email}`} class="block py-1 text-[#d5d8dd] no-underline hover:text-white">{site.email}</a>
          <span class="block py-1">{site.address}</span>
          <span class="block py-1">{site.hours}</span>
        </div>
      </div>
      <div class="wrap border-t border-[#333] pt-4 pb-6 text-[#a8aeb6]">© {year} {site.name}. Product catalogue — prices on request.</div>
    </footer>

    <Toaster client:idle />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
