# Copy this file to .env and fill in the values. Never commit .env to Git.

# Business WhatsApp number: international format, digits only (no + or spaces)
WHATSAPP_NUMBER=923000000000
WHATSAPP_DISPLAY=+92 300 0000000

# Live site address (used in sitemap, QR codes and WhatsApp messages)
BASE_URL=https://galaxytraderco.com

# Where product images are served from. Leave empty on your PC to preview
# with local images; on the live site use the R2 sub-domain.
IMG_BASE_URL=

# Cloudflare R2 (only needed for: python process_images.py --upload)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=galaxytrader-img
R2_ORIGINALS_BUCKET=galaxytrader-originals
